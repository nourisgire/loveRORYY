<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>For Rochdi Menaja ❤️</title>

  <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&family=Poppins:wght@300;500;700&display=swap" rel="stylesheet">

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      min-height: 100vh;
      overflow: hidden;
      font-family: "Poppins", sans-serif;
      background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 50%, #ff758c 100%);
    }

    .hearts-container {
      position: fixed;
      inset: 0;
      pointer-events: none;
    }

    .floating-heart {
      position: absolute;
      bottom: -60px;
      color: rgba(255, 255, 255, 0.8);
      animation: floatUp linear infinite;
      user-select: none;
    }

    @keyframes floatUp {
      0% {
        transform: translateY(0) rotate(0deg) scale(0.8);
        opacity: 1;
      }
      100% {
        transform: translateY(-115vh) rotate(360deg) scale(1.3);
        opacity: 0;
      }
    }

    .card {
      position: absolute;
      z-index: 10;
      top: 50%;
      left: 50%;
      width: min(550px, 90%);
      padding: 3rem 2.5rem;
      transform: translate(-50%, -50%);
      text-align: center;
      background: rgba(255, 255, 255, 0.88);
      border: 3px solid white;
      border-radius: 30px;
      box-shadow: 0 20px 50px rgba(214, 51, 108, 0.25);
      backdrop-filter: blur(12px);
      animation: popIn 1s ease-out;
    }

    @keyframes popIn {
      0% {
        opacity: 0;
        transform: translate(-50%, -50%) scale(0.8);
      }
      100% {
        opacity: 1;
        transform: translate(-50%, -50%) scale(1);
      }
    }

    .beating-heart {
      display: inline-block;
      margin-bottom: 10px;
      font-size: 4rem;
      animation: heartbeat 1.2s infinite;
    }

    @keyframes heartbeat {
      0%, 100% { transform: scale(1); }
      25% { transform: scale(1.2); }
      50% { transform: scale(1); }
      75% { transform: scale(1.15); }
    }

    h1 {
      margin-bottom: 15px;
      color: #d6336c;
      font-family: "Dancing Script", cursive;
      font-size: 3.5rem;
      text-shadow: 2px 2px 4px rgba(214, 51, 108, 0.15);
    }

    p {
      margin-bottom: 25px;
      color: #59253a;
      font-size: 1.15rem;
      line-height: 1.7;
    }

    .love-btn {
      padding: 15px 35px;
      border: none;
      border-radius: 50px;
      color: white;
      background: linear-gradient(45deg, #ff4d6d, #ff758f);
      box-shadow: 0 10px 20px rgba(255, 77, 109, 0.35);
      cursor: pointer;
      font-size: 1.1rem;
      font-weight: 600;
      transition: 0.2s ease;
    }

    .love-btn:hover {
      transform: translateY(-3px) scale(1.05);
      box-shadow: 0 15px 25px rgba(255, 77, 109, 0.45);
    }

    .love-btn:active {
      transform: scale(0.98);
    }

    #secret-message {
      min-height: 30px;
      margin-top: 20px;
      color: #c9184a;
      font-size: 1.2rem;
      font-weight: 600;
    }

    @media (max-width: 480px) {
      .card {
        padding: 2.2rem 1.3rem;
      }

      h1 {
        font-size: 2.7rem;
      }

      p {
        font-size: 1rem;
      }
    }
  </style>
</head>

<body>
  <div class="hearts-container" id="hearts-container"></div>

  <main class="card">
    <div class="beating-heart" aria-hidden="true">💖</div>
    <h1>I Love You, Rochdi Menaja ❤️</h1>

    <p>
      Every moment with you feels special.
      You make my ordinary days feel magical,
      and my heart is happiest whenever you are near.
      No matter where life takes us, I will always cherish you.
    </p>

    <button class="love-btn" id="love-button" type="button">
      Tap for a surprise
    </button>

    <div id="secret-message" role="status"></div>
  </main>

  <script>
    const heartsContainer = document.getElementById("hearts-container");
    const loveButton = document.getElementById("love-button");
    const secretMessage = document.getElementById("secret-message");

    function createFloatingHeart() {
      const heart = document.createElement("span");

      heart.className = "floating-heart";
      heart.textContent = Math.random() > 0.5 ? "❤️" : "💗";
      heart.style.left = Math.random() * 100 + "vw";
      heart.style.fontSize = 15 + Math.random() * 35 + "px";
      heart.style.animationDuration = 5 + Math.random() * 5 + "s";

      heartsContainer.appendChild(heart);

      heart.addEventListener("animationend", () => heart.remove());
    }

    setInterval(createFloatingHeart, 350);

    loveButton.addEventListener("click", () => {
      secretMessage.textContent = "You are my favorite person forever! 💕";

      for (let i = 0; i < 30; i++) {
        setTimeout(createFloatingHeart, i * 35);
      }
    });
  </script>
</body>
</html>
